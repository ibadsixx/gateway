{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "api/[...slug].ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/project-health/run", "schedule": "*/10 * * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/[...slug]" }
  ]
}
