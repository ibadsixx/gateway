# Tone API Gateway — LiveKit OSS configuration (development)
#
# Copy to .env and adjust values before running `npm run dev`.
# API key and secret remain server-side only.
# Frontend never receives the secret — only the minted JWT token.

# LiveKit OSS server (self-hosted, no cloud dependency)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://localhost:7880

# Supabase / database (existing configuration)
# DATABASE_URL=...
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...

# Auth / JWT
# JWT_SECRET=...

# CORS
# CORS_ORIGIN=http://localhost:5173
