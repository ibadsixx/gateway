# Tone API Gateway — configuration example
#
# Values are intentionally omitted. Copy to .env for local development, or add
# the same names as Hugging Face Space Secrets (sensitive) / Variables (plain).
# No media-server credentials are required: Tone Live uses browser-to-browser
# WebRTC. Signaling state lives in Supabase through this Gateway.

# Required: Supabase infrastructure registry + auth credential source.
# This is the existing infrastructure project. Do not point it at a domain
# project; domain routing stays in the infrastructure_projects table.
INFRA_SUPABASE_URL=
INFRA_SUPABASE_KEY=
AUTH_DOMAIN=users

# CORS: comma-separated exact origins. If unset, current middleware allows all
# origins. Keep the existing production frontend origin in the Space Variable.
CORS_ORIGINS=https://tonesn.vercel.app
PUBLIC_SITE_URL=https://tonesn.vercel.app

# Container runtime. Hugging Face Spaces exposes PORT; HOST must be 0.0.0.0.
HOST=0.0.0.0
PORT=7860

# Optional admin / scheduler credentials. Leave unset only if the route is not
# used; set as Secrets when enabling the endpoint.
ADMIN_API_KEY=
CRON_SECRET=
KEEP_ALIVE_TOKEN=
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_CHECKS_PER_DAY=
KEEP_ALIVE_TICK_MIN_GAP_MS=
KEEP_ALIVE_TICK_INTERVAL_MS=

# Optional infrastructure query override. Treat as a Secret if it embeds a URL
# token or credential.
INFRA_QUERY_API_TEMPLATE=

# Optional diagnostics / feature switches.
GROUP_DEBUG_RESPONSE=
HASHTAG_BACKFILL_ADMIN_IDS=

# Optional TURN credentials for restrictive networks. Never commit values.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Legacy names retained in older notes are NOT read by current code:
# DATABASE_URL, SUPABASE_URL, SUPABASE_ANON_KEY, JWT_SECRET, CORS_ORIGIN.

# Vercel WebSockets require Fluid compute on the existing Vercel project. That
# deployment is unchanged. The Docker image uses src/dockerServer.ts instead.
# No Supabase schema change or migration is part of this migration preparation.
