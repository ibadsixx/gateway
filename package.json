{
  "name": "tone-api-gateway",
  "version": "1.0.0",
  "description": "Tone API Gateway - Single entry point for the Tone ecosystem",
  "main": "dist/src/dev.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/dev.js",
    "dev": "ts-node src/dev.ts",
    "test:channel-moderator": "ts-node src/features/channelModeratorTest.ts",
    "test:group-settings": "ts-node src/features/groupSettingsTest.ts",
    "test:group-members": "ts-node src/features/groupMembersTest.ts",
    "verify:message-requests": "ts-node src/features/verifyMessageRequestCategory.ts",
    "test:channel-permissions": "ts-node src/features/channelPermissionsTest.ts",
    "test:scheduled-privacy": "ts-node src/features/scheduledPostPrivacyTest.ts",
    "test:people-you-may-know": "ts-node src/features/peopleYouMayKnowTest.ts",
    "test:story-privacy": "ts-node src/features/storyPrivacyTest.ts",
    "test:highlight-privacy": "ts-node src/features/highlightPrivacyTest.ts",
    "test:guest-access": "ts-node src/features/guestAccessTest.ts",
    "test:relationship-counts": "ts-node src/features/relationshipCountsTest.ts",
    "test:reaction-counts": "ts-node src/features/reactionCountsTest.ts",
    "test:storage-sign": "ts-node src/features/storageSignTest.ts",
    "test:storage-resolve": "ts-node src/features/storageResolveTest.ts",
    "test:all-channel": "npm run test:channel-moderator && npm run test:channel-permissions"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@types/pg": "^8.20.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "ws": "^8.21.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}